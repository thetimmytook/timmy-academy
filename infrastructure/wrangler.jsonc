{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "timmy-academy-api-local",
  "main": "../apps/api/src/index.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "assets": {
    "directory": "../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "BENCHMARK_DB",
      "database_name": "timmy-academy-benchmark-local",
      "database_id": "local-only",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
  "env": {
    "staging": {
      "name": "timmy-academy-staging",
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "BENCHMARK_DB",
          "database_name": "timmy-academy-benchmark-staging",
          "database_id": "b9cca271-6f9b-4d4d-95a3-7a05edf71649",
          "migrations_dir": "migrations",
        },
      ],
      "vars": { "DISABLE_INDEXING": "true" },
      "routes": [{ "pattern": "staging.timmy.academy", "custom_domain": true }],
    },
    "production": {
      "name": "timmy-academy-production",
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMIT",
          "namespace_id": "1003",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "BENCHMARK_DB",
          "database_name": "timmy-academy-benchmark-production",
          "database_id": "34df9e9d-4060-4ecf-b0b1-f7523594f085",
          "migrations_dir": "migrations",
        },
      ],
      "routes": [{ "pattern": "timmy.academy", "custom_domain": true }],
    },
  },
}
