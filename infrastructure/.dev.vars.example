# Browser auth for the main API. Use separate Clerk instances/keys per environment.
APP_ORIGIN=http://localhost:5173
CLERK_ISSUER=https://REPLACE.clerk.accounts.dev
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE
