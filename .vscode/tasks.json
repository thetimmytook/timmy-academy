{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Academy: build contracts",
      "type": "shell",
      "command": "npm run build -w @timmy/contracts",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "close": true,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "Academy: seed local DB",
      "icon": { "id": "database", "color": "terminal.ansiGreen" },
      "type": "shell",
      "command": "npm run db:seed:local",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "focus": false, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Academy: reset local DB",
      "icon": { "id": "database", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "npm run db:reset:local",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "focus": false, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Academy: watch contracts",
      "type": "shell",
      "command": "npm run dev -w @timmy/contracts",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "focus": false, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Academy: API",
      "icon": { "id": "gear", "color": "terminal.ansiBlue" },
      "type": "shell",
      "command": "npm run dev -w @timmy/api",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "focus": false, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Academy: Web",
      "icon": { "id": "browser", "color": "terminal.ansiGreen" },
      "type": "shell",
      "command": "npm run dev -w @timmy/web",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "focus": false, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Academy: start services",
      "dependsOrder": "parallel",
      "dependsOn": ["Academy: watch contracts", "Academy: API", "Academy: Web"],
      "hide": true
    },
    {
      "label": "Academy: dev",
      "group": { "kind": "build", "isDefault": true },
      "dependsOrder": "sequence",
      "dependsOn": ["Academy: build contracts", "Academy: start services"]
    }
  ]
}
