meta {
  name: 06 Unavailable collection
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/bench/v1/runs/br_test_desktop_0_lighthouse_bsg_servers_2560_2
  body: none
  auth: none
}

tests {
  test('Unavailable collection remains an explicit synthetic capture', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.is_synthetic).to.equal(true);
    expect(body.public_run_id).to.equal('br_test_desktop_0_lighthouse_bsg_servers_2560_2');
    const telemetry = body.resource_telemetry;
    expect(telemetry.schema_version).to.equal(1);
    expect(telemetry.status).to.equal('unavailable');
    expect(body.metrics.average_fps).to.be.greaterThan(0);
    expect(telemetry.cpu.total_utilization.average).to.equal(null);
    expect(telemetry.cpu.total_utilization.coverage).to.equal(0);
    expect(telemetry.cpu.total_utilization.valid_sample_count).to.equal(0);
    expect(telemetry.cpu.logical_processors).to.have.lengthOf(0);
    expect(telemetry.pagefile.files).to.have.lengthOf(0);
  });
}

docs {
  Requires the full 397-run demo seed in the selected environment. This request only reads one invented example and never uploads a run or changes data. Peaks do not establish a cause of FPS drops.
}
