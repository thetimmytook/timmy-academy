meta {
  name: 04 Low commit headroom
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/bench/v1/runs/br_test_desktop_0_lighthouse_bsg_servers_2560_0
  body: none
  auth: none
}

tests {
  test('Low commit headroom remains an explicit synthetic capture', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.is_synthetic).to.equal(true);
    expect(body.public_run_id).to.equal('br_test_desktop_0_lighthouse_bsg_servers_2560_0');
    const telemetry = body.resource_telemetry;
    expect(telemetry.schema_version).to.equal(1);
    expect(telemetry.status).to.equal('available');
    expect(telemetry.commit.headroom.minimum).to.be.below(2 ** 30);
    expect(telemetry.ram.physical_available.minimum).to.be.greaterThan(2 ** 30);
    expect(telemetry.commit.used.last + telemetry.commit.headroom.last).to.equal(telemetry.commit.limit.last);
  });
}

docs {
  Requires the full 397-run demo seed in the selected environment. This request only reads one invented example and never uploads a run or changes data. Peaks do not establish a cause of FPS drops.
}
