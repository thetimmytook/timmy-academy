meta {
  name: 01 Normal capture
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/bench/v1/runs/br_test_desktop_0_lighthouse_bsg_servers_1920_0
  body: none
  auth: none
}

tests {
  test('Normal capture remains an explicit synthetic capture', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.is_synthetic).to.equal(true);
    expect(body.public_run_id).to.equal('br_test_desktop_0_lighthouse_bsg_servers_1920_0');
    const telemetry = body.resource_telemetry;
    expect(telemetry.schema_version).to.equal(1);
    expect(telemetry.status).to.equal('available');
    expect(telemetry.gpu.graphics_utilization.source).to.equal('pdh_gpu_engine_3d_busiest_engine');
    expect(telemetry.cpu.logical_processors.length).to.be.greaterThan(0);
    expect(telemetry.gpu.dedicated_memory_used.maximum).to.be.below(telemetry.gpu.dedicated_vram_capacity.value * 0.95);
    expect(telemetry.ram.physical_available.minimum).to.be.greaterThan(2 * 2 ** 30);
    expect(telemetry.commit.headroom.minimum).to.be.greaterThan(2 * 2 ** 30);
  });
}

docs {
  Requires the full 397-run demo seed in the selected environment. This request only reads one invented example and never uploads a run or changes data. Peaks do not establish a cause of FPS drops.
}
