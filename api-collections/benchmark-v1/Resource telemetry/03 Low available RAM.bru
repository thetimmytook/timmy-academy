meta {
  name: 03 Low available RAM
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/bench/v1/runs/br_test_desktop_0_lighthouse_bsg_servers_1920_2
  body: none
  auth: none
}

tests {
  test('Low available RAM remains an explicit synthetic capture', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.is_synthetic).to.equal(true);
    expect(body.public_run_id).to.equal('br_test_desktop_0_lighthouse_bsg_servers_1920_2');
    const telemetry = body.resource_telemetry;
    expect(telemetry.schema_version).to.equal(1);
    expect(telemetry.status).to.equal('available');
    expect(telemetry.ram.physical_available.minimum).to.be.below(2 ** 30);
    expect(telemetry.commit.headroom.minimum).to.be.greaterThan(2 ** 30);
    expect(telemetry.ram.physical_used.average + telemetry.ram.physical_available.average).to.equal(telemetry.ram.os_usable_capacity.value);
  });
}

docs {
  Requires the full 397-run demo seed in the selected environment. This request only reads one invented example and never uploads a run or changes data. Peaks do not establish a cause of FPS drops.
}
