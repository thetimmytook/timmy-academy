meta {
  name: 05 Partial collection
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/bench/v1/runs/br_test_desktop_0_lighthouse_bsg_servers_2560_1
  body: none
  auth: none
}

tests {
  test('Partial collection remains an explicit synthetic capture', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.is_synthetic).to.equal(true);
    expect(body.public_run_id).to.equal('br_test_desktop_0_lighthouse_bsg_servers_2560_1');
    const telemetry = body.resource_telemetry;
    expect(telemetry.schema_version).to.equal(1);
    expect(telemetry.status).to.equal('partial');
    expect(telemetry.cpu.total_utilization.status).to.equal('partial');
    expect(telemetry.cpu.total_utilization.coverage).to.equal(0.75);
    expect(telemetry.gpu.graphics_utilization.status).to.equal('unavailable');
    expect(telemetry.gpu.graphics_utilization.average).to.equal(null);
    expect(telemetry.pagefile.automatic_management).to.equal(null);
  });
}

docs {
  Requires the full 397-run demo seed in the selected environment. This request only reads one invented example and never uploads a run or changes data. Peaks do not establish a cause of FPS drops.
}
