meta {
  name: 02 Search groups
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/bench/v1/runs?gpu=geforce-rtx-4070-super&limit=1
  body: none
  auth: none
}

tests {
  test('returns one hardware group and a continuation', function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.view).to.equal('groups');
    expect(body.groups).to.have.lengthOf(1);
    expect(body.groups[0].group_key).to.match(/^hg_/);
    expect(body.groups[0].preview_runs).to.be.an('array');
    expect(body.next_cursor).to.match(/^cur_/);
    bru.setVar('group_key', body.groups[0].group_key);
    bru.setVar('groups_cursor', body.next_cursor);
  });
}

docs {
  Uses the synthetic GPU catalog. The selected group and continuation cursor are saved for the next requests.
}
